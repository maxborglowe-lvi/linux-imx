	pinctrl_seesaw: seesawgrp {
		/* i.MX 8M Plus Applications Processor Reference Manual, Rev. 1, 06/2021 - p.1616-1617
		bit 8: Pull enable - Enable (1)
		bit 7: Input select - CMOS (0)
		bit 6: Pull-up/down - up (1)
		bit 5: Open-drain - Disable (0)
		bit 4: Slew-rate - Slow (0)
		bit 3: reserved (0)
		bit 2-1: Drive strength - DSE_X6 (11)
		bit 0: reserved (0)
		--> 101000110 = 0x146 */
		fsl,pins = <
			MX8MP_IOMUXC_NAND_READY_B__GPIO3_IO16 0x140
		>;
	};

